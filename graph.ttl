ex:fromBusyCountry a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:boolean .

ex:locatedIn a rdf:Property ;
    rdfs:domain ex:City ;
    rdfs:range ex:Country .

ex:operatedBy a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range ex:Airline .

ex:priceEur a rdf:Property ;
    rdfs:domain ex:Flight ;
    rdfs:range xsd:decimal .

ex:reportedBy a rdf:Property ;
    rdfs:domain rdf:Statement ;
    rdfs:range rdfs:Resource .

<http://example.org/mkr/stmt/FL-2950-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-2950> .

<http://example.org/mkr/stmt/FL-3639-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-3639> .

<http://example.org/mkr/stmt/FL-3786-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/FlightLog> ;
    rdf:object 15 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-3786> .

<http://example.org/mkr/stmt/FL-5608-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 10 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-5608> .

<http://example.org/mkr/stmt/FL-8239-delay> a rdf:Statement ;
    ex:reportedBy <http://example.org/mkr/source/AirWatch> ;
    rdf:object 10 ;
    rdf:predicate ex:hasDelayMinutes ;
    rdf:subject <http://example.org/mkr/flight/FL-8239> .

